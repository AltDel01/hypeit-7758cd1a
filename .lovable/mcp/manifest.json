{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mkwinxbualpcivkujlfd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "viralin-ai-mcp",
      "version": "0.1.0",
      "title": "Viralin AI"
    },
    "tools": [
      {
        "name": "list_recent_generations",
        "title": "List recent generations",
        "description": "List the signed-in user's most recent Viralin AI generation requests (image or video) with status and result URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "How many recent requests to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pending",
                    "processing",
                    "completed",
                    "failed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional status filter. Null returns all."
            }
          },
          "required": [
            "status"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_credit_balance",
        "title": "Get credit balance",
        "description": "Return the signed-in user's Viralin AI credit balance: monthly limit, credits used this period, remaining credits, subscription tier, and bonus credits.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_posting_history",
        "title": "List posting history",
        "description": "List the signed-in user's recent Creative Workflow posts (concept, platforms, status, scheduled_for) from the posting history.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "How many recent posts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
